# Copy to .env for LOCAL development only. Never commit the real .env.
# On Render, set these in the dashboard (Environment tab).

# External MySQL 8 database (Aiven example - replace every placeholder):
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED
# Optional: Aiven CA certificate (file path or PEM text) so the server certificate is verified
DATABASE_SSL_CA=

# Long random string (>= 32 chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
APP_ENV=development
# Comma-separated origins allowed for cross-origin calls. Empty = same-origin only (production).
CORS_ORIGINS=

# First administrator (used by `python -m app.cli create-admin` or AUTO_BOOTSTRAP=true)
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_PASSWORD=

# "true" = on start-up run the idempotent SQL files and create the admin. Default false.
AUTO_BOOTSTRAP=false
